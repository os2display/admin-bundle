<main role="main" class="content">
  <div class="content--inner">

    <div class="grid is-full ">
      <div class="grid--inner">
        <article class="grid--item">
          <article class="box">
            <form action="{{ path('fos_user_resetting_reset', {'token': token}) }}" }}
                  method="POST" class="fos_user_resetting_reset">
              <h2 class="heading-has-spacing-after">Skift kodeord</h2>
              <div class="box--inner">
                <div class="forms-field">
                  {{ form_widget(form) }}
                <div>
                  <input type="submit" class="button-link has-spacing-top"
                         title="Fortsæt" value="{{ 'resetting.reset.submit'|trans({}, 'FOSUserBundle') }}">
                </div>
                {{ form_rest(form) }}
              </div>
            </form>
          </article>
        </article>
      </div>
    </div>
  </div>
</main>
